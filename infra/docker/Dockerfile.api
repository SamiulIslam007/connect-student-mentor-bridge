# syntax=docker/dockerfile:1
ARG NODE_VERSION=24.19.0
ARG PNPM_VERSION=12.16.1

FROM node:${NODE_VERSION}-alpine AS base
ARG PNPM_VERSION
ENV PNPM_HOME=/pnpm \
    PATH=/pnpm:$PATH
RUN corepack enable && corepack prepare pnpm@${PNPM_VERSION} --activate
WORKDIR /app

# Workspace manifests only, so dependency layers cache independently of source.
FROM base AS manifests
COPY package.json pnpm-lock.yaml pnpm-workspace.yaml ./
COPY apps/web/package.json apps/web/
COPY services/api/package.json services/api/
COPY packages/domain/package.json packages/domain/
COPY packages/config/package.json packages/config/
COPY packages/contracts/package.json packages/contracts/

FROM manifests AS deps
RUN --mount=type=cache,id=pnpm-store,target=/pnpm/store \
    pnpm install --frozen-lockfile

FROM deps AS build
COPY tsconfig.base.json ./
COPY services/api services/api
COPY packages/domain packages/domain
COPY packages/config packages/config
COPY packages/contracts packages/contracts
RUN pnpm --filter api build

# Development stage: full install, source is bind-mounted by compose.dev.yaml.
FROM deps AS dev
COPY tsconfig.base.json ./
COPY services/api services/api
COPY packages packages
CMD ["pnpm", "--filter", "api", "dev"]

# Production dependencies only, hoisted into one runtime node_modules.
FROM manifests AS prod-deps
RUN --mount=type=cache,id=pnpm-store,target=/pnpm/store \
    pnpm install --prod --frozen-lockfile --node-linker=hoisted

FROM node:${NODE_VERSION}-alpine AS runtime
ENV NODE_ENV=production
WORKDIR /app
# npm and corepack are build-time tools; removing them also removes their
# bundled dependencies from the runtime image.
RUN rm -rf /usr/local/lib/node_modules/npm \
    /usr/local/lib/node_modules/corepack \
    /usr/local/bin/npm /usr/local/bin/npx /usr/local/bin/corepack
COPY --from=prod-deps /app/node_modules ./node_modules
COPY --from=prod-deps /app/services/api/package.json ./package.json
COPY --from=build /app/services/api/dist ./dist
COPY infra/docker/healthcheck.mjs ./healthcheck.mjs
USER node
EXPOSE 3001
CMD ["node", "dist/main.js"]
