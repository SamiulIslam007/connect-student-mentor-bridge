# Process
NODE_ENV=development
LOG_LEVEL=info
PORT=3001

# Database. Compose builds its own DATABASE_URL (host `postgres`); the value
# below is for tools run on the host against the published port.
POSTGRES_USER=connect
POSTGRES_PASSWORD=local-dev-only
POSTGRES_DB=connect
POSTGRES_PORT=55432
DATABASE_URL=postgresql://connect:local-dev-only@localhost:55432/connect

# Object storage (S3-compatible; the local stack runs versitygw).
S3_ENDPOINT=http://objectstore:7070
S3_REGION=us-east-1
S3_BUCKET=connect-local
S3_ACCESS_KEY_ID=local-dev-only
S3_SECRET_ACCESS_KEY=local-dev-only
S3_FORCE_PATH_STYLE=true
S3_PORT=7070

# Mail (Mailpit locally; transactional provider in deployment)
SMTP_HOST=mailpit
SMTP_PORT=1025
SMTP_USER=local-dev-only
SMTP_PASSWORD=local-dev-only
SMTP_FROM=no-reply@connect.local
MAILPIT_SMTP_PORT=1025
MAILPIT_HTTP_PORT=8025

# Malware scanner (ClamAV locally; scan integration is a later change)
CLAMAV_HOST=clamav
CLAMAV_PORT=3310

# Web
NEXT_PUBLIC_APP_NAME=connect
NEXT_PUBLIC_API_BASE_URL=http://localhost:3001

# Published local ports
WEB_PORT=3000
API_PORT=3001
