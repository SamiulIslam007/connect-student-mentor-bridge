{
  "name": "api",
  "version": "0.0.0",
  "private": true,
  "scripts": {
    "dev": "tsx watch src/main.ts",
    "dev:worker": "tsx watch src/worker.ts",
    "build": "tsup",
    "start": "node dist/main.js",
    "start:worker": "node dist/worker.js",
    "typecheck": "tsc --noEmit",
    "test": "node --import tsx --test --test-concurrency=1 test/*.test.ts",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "db:seed": "node --import tsx src/db/seed/run.ts",
    "outbox:test-event": "node --import tsx src/platform/outbox/test-event.ts",
    "db:seed:demo": "node --import tsx src/db/seed/run-demo.ts"
  },
  "dependencies": {
    "@better-auth/drizzle-adapter": "1.7.15",
    "@connect/config": "workspace:*",
    "@connect/contracts": "workspace:*",
    "@connect/domain": "workspace:*",
    "@nestjs/common": "12.3.2",
    "@nestjs/core": "12.3.2",
    "@nestjs/platform-express": "12.3.2",
    "@nestjs/throttler": "6.7.1",
    "better-auth": "1.7.15",
    "drizzle-orm": "0.45.4",
    "helmet": "8.3.0",
    "nodemailer": "10.3.1",
    "pg": "8.23.1",
    "pg-boss": "12.38.1",
    "reflect-metadata": "0.2.2",
    "rxjs": "7.8.2"
  },
  "devDependencies": {
    "@types/express": "5.0.6",
    "@types/nodemailer": "8.0.2",
    "@types/pg": "8.23.1",
    "drizzle-kit": "0.31.11",
    "tsup": "9.0.0"
  }
}
